<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below: back up the ledger and WebView storage, never the update cache. -->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="database" path="." />
    <include domain="file" path="." />
    <!-- localStorage / IndexedDB used by the Capacitor WebView. -->
    <include domain="root" path="app_webview/" />
    <exclude domain="file" path="updates/" />
    <exclude domain="file" path="cache/" />
</full-backup-content>
