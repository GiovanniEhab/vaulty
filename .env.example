# Firebase web app config — copy this file to .env and paste values from
# Firebase Console → Project settings → Your apps → SDK setup and configuration.
# These values are public by design (they identify the project, they are not secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: override where the Android app looks for updates (GitHub "latest release" JSON or a manifest).
# Defaults to https://api.github.com/repos/GiovanniEhab/vaulty/releases/latest
VITE_UPDATE_FEED=
