rules_version = '2';

// Vaulty: every signed-in user can only read/write their own document and the
// five ledgers nested under it (accounts, transactions, budgets, goals, recurring).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{collectionName}/{documentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
